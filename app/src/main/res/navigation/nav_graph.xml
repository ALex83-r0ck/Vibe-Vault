<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.alexander.vibevault.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_addEntryFragment"
            app:destination="@id/addEntryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_statsFragment"
            app:destination="@id/statsFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEntryFragment"
        android:name="com.alexander.vibevault.AddEntryFragment"
        android:label="Add Entry" />

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.alexander.vibevault.StatsFragment"
        android:label="Stats" />
</navigation>